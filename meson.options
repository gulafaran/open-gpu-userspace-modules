option('nvidia-gbm', type : 'feature', value : 'enabled',
       description : 'GBM backend for nvidia-drm')
option('nvidia-allocator', type : 'feature', value : 'disabled',
       description : 'Install libnvidia-allocator.so.1 in place of the driver\'s (GEM handle refcounts for NVIDIA EGL/GL/Vulkan) and make nvidia-gbm the nvidia-drm_gbm.so backend')
option('nvchan', type : 'feature', value : 'enabled',
       description : 'GPU command submission library')
option('kernel_src', type : 'string', value : '',
       description : 'open-gpu-kernel-modules tree nvchan builds against (default: the copy in third_party/)')
option('nvidia-ml', type : 'feature', value : 'disabled',
       description : 'libnvidia-ml.so.1 (NVML) replacement')
